				(size 1.2 1.2)
			)
			(justify top)
		)
		(uuid "0ed86792-7267-55c7-97cc-539ad189d3dc")
	)
	(text "D9 is the MSB.  Pin numbers with a \"?\" are not\nchecked against the SD9609 data sheet."
