	(text "DRIVER, ADC AND CLOCK"
		(exclude_from_sim no)
		(at 20.32 25.4 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "6f55d884-ecf5-54b8-a9ab-7ac2bee5e2e8")
	)
	(text "Single-ended to differential at gain 1, 10 bit 40 MSPS conversion, and the one 40 MHz oscillator that clocks the ADC, the controller and both synthesizers."
		(exclude_from_sim no)
		(at 20.32 31.75 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "cf91b905-6fbb-579d-93df-0d395c6c3c1d")
	)
	(text "ADC driver\nFB+ and FB- are the outputs, brought out beside the inputs"
		(exclude_from_sim no)
		(at 88.9 61.44 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify bottom)
		)
		(uuid "05ffd2d4-8333-5f6c-83a3-c9f86ecabb06")
	)
	(text "3.3 V CMOS halved\nand AC coupled"
		(exclude_from_sim no)
		(at 104.84 146.16 0)
		(effects
